{
  "manifest_version": 3,
  "name": "Amazon Rewards Coupon Collector",
  "version": "1.1",
  "description": "Automatically collect all available coupons on Amazon Rewards page in mobile view",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://amazon.in/*",
    "*://*.amzn.to/*",
    "*://amzn.to/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Collect Coupons"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/h/rewards*",
        "https://amazon.in/h/rewards*"
      ],
      "js": ["content.js"]
    }
  ]
}